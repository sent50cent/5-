#!/bin/bash
# Переходим в папку со скриптом
cd "$(dirname "$0")"

echo "==============================="
echo "🖼️  Шаг 1: Оптимизация картинок"
echo "==============================="
python3 update_and_build.py

echo ""
echo "==============================="
echo "🚀 Шаг 2: Отправка на GitHub..."
echo "==============================="

# Проверяем инициализирован ли Git
if [ ! -d ".git" ]; then
    echo "❗ Ошибка: папка .git не найдена."
    echo "Пожалуйста, инициализируйте репозиторий: git init"
    exit 1
fi

git add .
git commit -m "Автоматическое обновление контента: $(date +'%Y-%m-%d %H:%M:%S')"
git push origin main

echo ""
echo "✅ Готово! Ваши изменения отправлены на сервер."
echo "Через минуту сайт обновится по вашей ссылке на GitHub Pages."
sleep 5
